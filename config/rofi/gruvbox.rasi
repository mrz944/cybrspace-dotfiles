* {
    bg0:     #282828;
    bg1:     #3c3836;
    bg2:     #504945;
    fg:      #ebdbb2;
    fg-alt:  #a89984;
    yellow:  #fabd2f;
    orange:  #fe8019;
    red:     #fb4934;
    border:  #504945;

    background-color: transparent;
    text-color:       @fg;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    background-color: @bg0;
    border:           2px solid;
    border-color:     @yellow;
    border-radius:    14px;
    width:            600px;
    padding:          20px;
    location:         center;
    anchor:           center;
}

mainbox {
    spacing: 15px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg1;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @yellow;
    font-weight: bold;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @fg-alt;
    text-color: @fg;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    spacing:      5px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       10px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @yellow;
    text-color:       @bg0;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
